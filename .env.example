# ============================================================================
# Reef Raiders — environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# ============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL of the API (used for CORS + cookie domain decisions)
PUBLIC_URL=http://localhost:3000
# Comma separated list of allowed browser origins (Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Uses the SQLite engine built into Node.js >= 22.5 (node:sqlite).
DB_FILE=./data/reef-raiders.db

# --- Security --------------------------------------------------------------
# MUST be a long random string in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789abcdef
JWT_ISSUER=reef-raiders
JWT_AUDIENCE=reef-raiders-web
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Game economy / gameplay -----------------------------------------------
# Starting DEMO COINS granted to a newly registered account.
STARTING_DEMO_COINS=10000
# Server simulation tick rate (ms). 50ms => 20 authoritative ticks/second.
SIM_TICK_MS=50
# Snapshot broadcast rate (ms) for multiplayer room synchronisation.
SNAPSHOT_MS=50
# Seconds a round stays active before it rolls over to a fresh round.
ROUND_DURATION_S=1800

# --- Real money -------------------------------------------------------------
# HARD FEATURE FLAG. Must stay `false` unless this deployment has obtained the
# independent licensing / KYC / AML / age-verification / geo-compliance
# approvals described in docs/COMPLIANCE.md. The code refuses to serve any
# real-money code path while this is false, and refuses to start in production
# with it set to true unless REAL_MONEY_ATTESTATION is also provided.
REAL_MONEY_ENABLED=false
REAL_MONEY_ATTESTATION=

# --- Bootstrap administrator (created on first run if missing) --------------
BOOTSTRAP_ADMIN_EMAIL=admin@reefraiders.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2345

# --- Operations -------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
